# BallDontLie API key (optional — rosters/games; game logs use ESPN/NBA fallback)
BALLDONTLIE_API_KEY=

# Upstash Redis (required on Vercel — from Storage → Redis / Upstash)
# Prefer REST pair when available:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Newer Vercel Marketplace Redis often only sets this (TCP). App derives REST from it.
REDIS_URL=

# Legacy Vercel KV names still work if present
KV_REST_API_URL=
KV_REST_API_TOKEN=

# NBA season start year for game logs (e.g. 2026 = 2026-27 season)
NBA_SEASON=2026

# Auth.js (Google sign-in for per-user slips + leaderboard)
# Generate: openssl rand -base64 32
AUTH_SECRET=
# Google Cloud Console → OAuth 2.0 Client (Web) — authorized redirect:
#   https://YOUR_DOMAIN/api/auth/callback/google
#   http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Optional aliases:
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
