# BallDontLie API key (optional — rosters/games; game logs use ESPN/NBA fallback)
BALLDONTLIE_API_KEY=

# Upstash Redis (required on Vercel — from Storage → Redis / Upstash)
# Prefer REST pair when available:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Newer Vercel Marketplace Redis often only sets this (TCP). App derives REST from it.
REDIS_URL=

# Legacy Vercel KV names still work if present
KV_REST_API_URL=
KV_REST_API_TOKEN=

# NBA season start year for game logs (e.g. 2026 = 2026-27 season)
NBA_SEASON=2026
